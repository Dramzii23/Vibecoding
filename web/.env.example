# ============================================================
# Vibecoding — Variables de entorno
# Copia este archivo a .env.local y rellena los valores
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Encuentra estas keys en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=

# --- OAuth providers (Gmail receta, opcional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Panel /admin (leads) ---
# Contraseña para entrar a /admin. Elige la tuya.
ADMIN_PASSWORD=

# --- Panel /superadmin (gestión de maestros y alumnos) ---
# Emails (separados por coma) que reciben el rol super_admin al
# iniciar sesión. El primero de la lista es el bootstrap: si nadie
# más es admin todavía, esta cuenta siempre puede entrar.
SUPER_ADMIN_EMAILS=

# --- Resend webhook (opcional) ---
# Firma del webhook en api/webhooks/resend — https://resend.com/webhooks
RESEND_WEBHOOK_SECRET=
